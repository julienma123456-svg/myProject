 241   3            break;
 242   3          }
 243   2        }
 244   1        
 245   1        //校准点小于2，计算不了
 246   1        if(pointNum < 2)
 247   1        {
 248   2          *err = 3;
 249   2          return 0;
 250   2        }
 251   1        
 252   1        //如果小于最小的一个校准点，按正比处理
 253   1        if(input < AdjustData[inx].Point[0].ValX)
 254   1        {
 255   2          float k = (float)AdjustData[inx].Point[0].ValY / AdjustData[inx].Point[0].ValX;
 256   2          *err = 0;
 257   2          return (k * input);
 258   2        } 
 259   1      
 260   1        //找到区间
 261   1        for(i = 0;i < pointNum;i++)
 262   1        {
 263   2          if(AdjustData[inx].Point[i].ValX > input)
 264   2          {
 265   3            findInx = i;
 266   3            break;
 267   3          }
 268   2        }
 269   1      
 270   1        //如果大于最大一个校准点，按最后两个校准点直线校准
 271   1        if(findInx == 0)
 272   1        {
 273   2          findInx = pointNum - 1;
 274   2        }
 275   1      
 276   1        //区间为(findInx - 1)和(findInx)之间
 277   1        {
 278   2          //y1 = k * x1 + b;
 279   2          //y2 = k * x2 + b;
 280   2          unsigned int x1 = AdjustData[inx].Point[findInx - 1].ValX;
 281   2          unsigned int y1 = AdjustData[inx].Point[findInx - 1].ValY; 
 282   2          unsigned int x2 = AdjustData[inx].Point[findInx].ValX;
 283   2          unsigned int y2 = AdjustData[inx].Point[findInx].ValY;
 284   2          k = (float)(y2 - y1)/(x2 - x1);
 285   2          b = y1 - k * x1;
 286   2        }
 287   1      
 288   1        *err = 0;
 289   1        return (k * input + b);
 290   1      }
