   6          //========================================================================
   7          // 函数: void UART1_config(u8 brt)
   8          // 描述: UART1初始化函数。
   9          // 参数: baudRate: 波特率,使用Timer1做波特率.
  10          // 返回: none.
  11          // 版本: VER1.0
  12          // 日期: 2014-11-28
  13          // 备注: 
  14          //========================================================================
  15          void UART1_Config(unsigned long baudRate,InVoid_OutVoid fSend,InU8_OutVoid fRec)    
  16          {
  17   1        unsigned long xdata reload = 0;
  18   1        reload = 65536UL - (MAIN_Fosc / 4) / baudRate;
  19   1      
  20   1        TR1 = 0;
  21   1          AUXR &= ~0x01;      //S1 BRT Use Timer1;
  22   1          AUXR |=  (1<<6);    //Timer1 set as 1T mode
  23   1          TMOD &= ~(1<<6);    //Timer1 set As Timer
  24   1          TMOD &= ~0x30;      //Timer1_16bitAutoReload;
  25   1          TH1 = reload / 256;
  26   1          TL1 = reload % 256;
  27   1          ET1 = 0;    //禁止中断
  28   1          INT_CLKO &= ~0x02;  //不输出时钟
  29   1          TR1  = 1;
  30   1      
  31   1        //UART1模式, 0x00: 同步移位输出, 0x40: 8位数据,可变波特率, 
  32   1        SCON = (SCON & 0x3f) | 0x40;    
  33   1      //  PS  = 1;    //高优先级中断
  34   1          ES  = 1;    //允许中断
  35   1          REN = 1;    //允许接收
  36   1          P_SW1 &= 0x3f;
  37   1          P_SW1 |= 0x00;      //UART1 switch to, 0x00: P3.0 P3.1, 0x40: P3.6 P3.7, 0x80: P1.6 P1.7, 0xC0: P4.3 P
             -4.4
  38   1      //  PCON2 |=  (1<<4);   //内部短路RXD与TXD, 做中继, ENABLE,DISABLE
  39   1      
  40   1        funS1SendOneDataOk = fSend;
  41   1        funS1RecOneData = fRec;
  42   1      }
