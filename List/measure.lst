 188          //获取采集模拟量
 189          float MeasureGetAnalog(enumAnalogIndex index)
 190          {
 191   1        if(index >= Analog_NUM)
 192   1          return 0;
 193   1      
 194   1        if(index == Analog_InPower)   //入射清零值5W
 195   1        {
 196   2          if(MeasureStruct.AnalogVal[index] < 5)
 197   2            return 0;
 198   2        }
 199   1        else if(index == Analog_RefPower)   //反射清零值3W
 200   1        {
 201   2          if(MeasureStruct.AnalogVal[index] < 3)
 202   2            return 0;
 203   2        }
 204   1      
 205   1        return MeasureStruct.AnalogVal[index];  
 206   1      }
