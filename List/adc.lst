line level    source

   1          #include "adc.h"
   2          
   3          //ADC0功能：50V检测
   4          //ADC1功能：入射功率检测
   5          //ADC2功能：反射功率检测
   6          //ADC4功能：17A电流检测
   7          
   8          //采集通道P1.0 P1.1 P1.2 P1.4
   9          const unsigned char xdata ADC_ChVal[ADC_NUM] = {0,1,2,4};
  10          
  11          unsigned char ADC_ChIndex = 0; 
  12          unsigned int ADC_Result[ADC_NUM] = {0};
  13          
  14          //ADC初始化(采集一个数据需要32*16/375ms = 1.36ms)
  15          void ADC_Init(void)
  16          {
  17   1        //设置 P1.0 P1.1 P1.2 P1.4为 ADC 输入口
  18   1        P1M1 |= 0x17;   P1M0 &= 0x00;   //设置 ADC 输入口
  19   1      
  20   1        EnableXdata();
  21   1        ADCTIM = 0x3F;    //0 01 11111(采样时间为32个周期) 
  22   1        ADCEXCFG = 0x07;  //--00 -111(采样结果为16次平均值) 
  23   1        DisableXdata(); 
  24   1      
  25   1        IE |= 0x20;          //允许ADC中断
  26   1        ADCCFG = 0x2F;    //右对齐，16分频(时钟频率约为12/32=0.375M)
  27   1        ADC_CONTR = 0xC0;   //使能 ADC 模块，启动转换
  28   1      }
  29          
  30          //获取采集结果(刷新4个通道需要1.36*4ms = 5.44ms)
  31          unsigned int ADC_GetResult(unsigned char adcCh)
  32          {
  33   1        if(adcCh >= ADC_NUM)
  34   1          return 0xFFFF;
  35   1      
  36   1        return ADC_Result[adcCh]; 
  37   1      }
  38          
  39          //ADC采集完成中断
  40          void ADC_Int (void) interrupt 5
  41          {
  42   1        ADC_CONTR &= ~0x20;   //bit5
  43   1        ADC_Result[ADC_ChIndex] = (ADC_RES << 8) | ADC_RESL;
  44   1      
  45   1        //准备采集下一个通道
  46   1        ADC_ChIndex++;
  47   1        ADC_ChIndex = ADC_ChIndex % ADC_NUM;
  48   1        ADC_CONTR = 0xC0 | ADC_ChVal[ADC_ChIndex];
  49   1      }


