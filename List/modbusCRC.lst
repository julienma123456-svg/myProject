              // 移位法计算ModBus CRC16
              unsigned int ModBus_CalCRC16(const unsigned char *dataIn, unsigned int length)
              {
                unsigned char i = 0;
                unsigned char j = 0;
                unsigned int crc = 0xFFFF; // 初始值
              
                if (dataIn == 0)
                  return 0;
              
                for (i = 0; i < length; i++)
                {
                  crc ^= dataIn[i]; // 当前字节与CRC低字节异或
                  for (j = 0; j < 8; j++)
                  {
                    if (crc & 0x0001) // 检查最低位
                    {
                      crc >>= 1;     // 右移1位
                      crc ^= 0xA001; // 多项式 0x8005 的反转（0xA001）
                    }
                    else
                    {
                      crc >>= 1; // 直接右移
                    }
                  }
                }
                return crc; // 结果是低字节在前
              }
              
              #endif
