 562          //xxMHz功率输出控制命令(带校准)
 563          void ModBusCtrlOutPower(u8 *inData,u8 *outData,u8 *dataLen,u8 ctrInx)
 564          {
 565   1        char err = 0;
 566   1        unsigned char inx = 0;
 567   1        unsigned int outDAC = 0x00;
 568   1        unsigned int power = 0x00;
 569   1        unsigned int regAdd = 0x00;
 570   1      
 571   1        if(ctrInx >= 10)
 572   1        {
 573   2          return;
 574   2        }
 575   1      
 576   1        outData[inx++] = SELF_ADDRESS;
 577   1        outData[inx++] = CMD_WRITE_VAL;
 578   1      
 579   1        //寄存器地址
 580   1        regAdd = REG_Ctrl_OutPower_Min + ctrInx;
 581   1        outData[inx++] = regAdd >> 8;
 582   1        outData[inx++] = regAdd & 0xFF;
 583   1      
 584   1        //寄存器数量1
 585   1          outData[inx++] = 0x00;
 586   1        outData[inx++] = 0x01;
 587   1      
 588   1        power = inData[7] << 8 | inData[8];//单位10mW
 589   1      
 590   1        RefreshOutPowerFreq(ctrInx);
 591   1        outDAC = GetAdjustResult(enum75MHzPower + ctrInx,power,&err);
 592   1        if(!err)
 593   1        {
 594   2          //有校准数据，校准成功则输出DAC值
 595   2          WriteDAC(outDAC);
 596   2        }
 597   1        else
 598   1        {
 599   2          //校准失败则输出功率(按功率等比例输出DAC)
 600   2          outData[1] += 0x80 + err;
 601   2          OutputPower((float)power / 100);
 602   2        }
 603   1      
 604   1        *dataLen = inx;
 605   1      }
