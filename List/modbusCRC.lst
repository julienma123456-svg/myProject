  38          // 查表法计算ModBus CRC16
  39          unsigned int ModBus_CalCRC16(const unsigned char *dataIn, unsigned int length)
  40          {
  41   1        unsigned char i = 0;
  42   1        unsigned int crc = 0xFFFF; // 初始值
  43   1      
  44   1        if (dataIn == 0)
  45   1          return 0;
  46   1      
  47   1        for (i = 0; i < length; i++)
  48   1        {
  49   2          crc = (crc >> 8) ^ crc16_table[(crc ^ dataIn[i]) & 0xFF];
  50   2        }
  51   1        return crc; // 返回校验值（低位在前）
  52   1      }
