  13          // 备注: 
  14          //========================================================================
  15          void UART3_Config(unsigned long baudRate,InVoid_OutVoid fSend,InU8_OutVoid fRec)    
  16          {
  17   1        unsigned long reload = 0;
  18   1        reload = 65536UL - (MAIN_Fosc / 4) / baudRate;
  19   1      
  20   1          S3CON = 0x50;       //8位数据, 使用Timer3做波特率发生器, 允许接收
  21   1          T3H = reload / 256;
  22   1          T3L = reload % 256;
  23   1          T4T3M |= 0x0a;
  24   1      
  25   1          IE2 |= 0x08;          //允许UART3中断
  26   1      
  27   1      #ifdef SELECT_P0
  28   1        P0M1 &= 0xFC;   P0M0 &= 0xFC;   //设置为准双向口
  29   1          P_SW2 &= ~0x02;   //UART3 switch bit1 to: 0: P0.0 P0.1
  30   1      #else
                  P_SW2 |= 0x02;      //UART3 switch bit1 to: 1: P5.0 P5.1
              #endif
  33   1      
  34   1        funSendOneDataOk = fSend;
  35   1        funRecOneData = fRec;
  36   1      }
