 212          //计算校准结果
 213          float GetAdjustResult(enumAdjustIndex inx,unsigned int input,char *err)
 214          {
 215   1        char i = 0;
 216   1        char findInx = 0;
 217   1        int  arrayLen = 0;
 218   1        int  pointNum = 0;
 219   1        float k = 0,b = 0;
 220   1      
 221   1        if(inx >= enumAdjustNum)
 222   1        {
 223   2          *err = 1;
 224   2          return 0;
 225   2        }
 226   1      
 227   1        //没有校准记录
 228   1        if(!AdjustManage.IsAdjust[inx])
 229   1        {
 230   2          *err = 2;
 231   2          return 0;
 232   2        }
 233   1      
 234   1        arrayLen = sizeof(AdjustData[0].Point) / sizeof(AdjustData[0].Point[0]);
 235   1        //统计有多少个校准点(0xFFFF表示没有校准)
 236   1        for(i = 0;i < arrayLen;i++)
 237   1        {
 238   2          if(AdjustData[inx].Point[i].ValX == 0xFFFF)
 239   2          {
 240   3            pointNum = i;
