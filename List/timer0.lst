   5          //========================================================================
   6          // 函数: void   Timer0_init(void)
   7          // 描述: timer0初始化函数.
   8          // 参数: reload
   9          // 返回: none.
  10          // 版本: V1.0, 2025-6-4
  11          //========================================================================
  12          void Timer0_Init(unsigned int reload,InVoid_OutVoid fCallBack)
  13          {
  14   1        TR0 = 0;    //停止计数
  15   1        ET0 = 1;    //允许中断
  16   1        TMOD &= ~0x03;  //工作模式bit1bit0, 0: 16位自动重装
  17   1        //TMOD |= 0; 
  18   1        TMOD &= ~0x04;  //bit2，0为定时器
  19   1        INT_CLKO &= ~0x01;  //不输出时钟(P3.5)
  20   1        
  21   1        AUXR |=  0x80;  //bit7为1，不分频
  22   1        TH0 = (unsigned char)((65536UL - reload) / 256);
  23   1        TL0 = (unsigned char)((65536UL - reload) % 256);
  24   1        
  25   1        TR0 = 1;    //开始运行
  26   1      
  27   1        fIntCallBack = fCallBack;
  28   1      }
