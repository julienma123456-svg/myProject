 122          //保存校准数据到EEPROM
 123          void SaveAdjustData(enumAdjustIndex inx,DateStructType date)
 124          {
 125   1        unsigned int eeAdd = 0;
 126   1      
 127   1        if(inx >= enumAdjustNum)
 128   1        {
 129   2          return;
 130   2        }
 131   1      
 132   1        eeAdd = EE_ADD_InPower + inx * 0x100;
 133   1      
 134   1        AdjustData[inx].Flag = 0x11 * (inx + 1);
 135   1        AdjustData[inx].AdjustDate.Year  = date.Year;
 136   1        AdjustData[inx].AdjustDate.Month = date.Month;
 137   1        AdjustData[inx].AdjustDate.Day   = date.Day;
 138   1        AdjustData[inx].AdjustDate.Hour  = date.Hour;
 139   1        AdjustData[inx].AdjustDate.Min   = date.Min;
 140   1        AdjustData[inx].AdjustDate.Sec   = date.Sec;
 141   1        ArrayAddCheck((u8 *)&AdjustData[inx],EE_SIZE_ADJ);
 142   1      
 143   1        if(inx % 2 == 0)  //偶数，写入当前数据和下一个校准数据
 144   1        {
 145   2          EEPROM_SectorErase(eeAdd);
 146   2          EEPROM_WriteBytes(eeAdd,(u8 *)&AdjustData[inx],EE_SIZE_ADJ);  //写入第一份数据
 147   2          eeAdd = eeAdd + EE_SIZE_ADJ;
 148   2          EEPROM_WriteBytes(eeAdd,(u8 *)&AdjustData[inx],EE_SIZE_ADJ);  //写入第二份数据
 149   2      
 150   2          eeAdd = eeAdd + EE_SIZE_ADJ;
 151   2          EEPROM_WriteBytes(eeAdd,(u8 *)&AdjustData[inx + 1],EE_SIZE_ADJ);  //写入第一份数据
 152   2          eeAdd = eeAdd + EE_SIZE_ADJ;
 153   2          EEPROM_WriteBytes(eeAdd,(u8 *)&AdjustData[inx + 1],EE_SIZE_ADJ);  //写入第二份数据
 154   2        }
 155   1        else       //偶数，写入上一个校准数据和当前数据
 156   1        {
 157   2          eeAdd = eeAdd - 0x100;
 158   2          EEPROM_SectorErase(eeAdd);
 159   2          EEPROM_WriteBytes(eeAdd,(u8 *)&AdjustData[inx - 1],EE_SIZE_ADJ);  //写入第一份数据
 160   2          eeAdd = eeAdd + EE_SIZE_ADJ;
 161   2          EEPROM_WriteBytes(eeAdd,(u8 *)&AdjustData[inx - 1],EE_SIZE_ADJ);  //写入第二份数据
 162   2      
 163   2          eeAdd = eeAdd + EE_SIZE_ADJ;
