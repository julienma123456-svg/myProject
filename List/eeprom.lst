  13          //========================================================================
  14          // 函数: void EEPROM_read_n(u16 EE_address,u8 *DataAddress,u16 number)
  15          // 描述: 从指定EEPROM首地址读出n个字节放指定的缓冲.
  16          // 参数: EE_address:  读出EEPROM的首地址.
  17          //       DataAddress: 读出数据放缓冲的首地址.
  18          //       number:      读出的字节长度.
  19          // 返回: non.
  20          // 版本: V1.0, 2012-10-22
  21          //========================================================================
  22          void EEPROM_ReadBytes(u16 EE_address,u8 *DataAddress,u16 number)
  23          {
  24   1        EA = 0;     //禁止中断
  25   1        
  26   1        IAP_CONTR = 0x80; //使能 IAP
  27   1        IAP_TPS = TPS_VAL;  //设置擦除等待参数 24MHz
  28   1        IAP_CMD = 1;  //设置 IAP 读命令
  29   1        do
  30   1        {
  31   2          IAP_ADDRH = EE_address / 256; //设置 IAP 地址高字节
  32   2          IAP_ADDRL = EE_address % 256; //设置 IAP 地址低字节
  33   2          IAP_TRIG = 0x5a; //写触发命令(0x5a)
  34   2          IAP_TRIG = 0xa5; //写触发命令(0xa5)
  35   2          ;;;
  36   2          *DataAddress = IAP_DATA; //读 IAP 数据
  37   2          EE_address++;
  38   2          DataAddress++;
  39   2        }while(--number);
  40   1        DisableEEPROM();
  41   1        EA = 1;     //重新允许中断
  42   1      }
