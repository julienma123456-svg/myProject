   3          /*
   4          LED正极接单片机IO口，负极接地
   5          点亮LED时，IO口输出高电平
   6          DAC输出时，点亮LED1
   7          电源告警时，点亮LED2
   8          温度告警时，点亮LED3
   9          其它告警，点亮LED4
  10          */
  11          
  12          //LED点灯任务
  13          void LED_Task(void)
  14          {
  15   1        unsigned char alarm = 0;
  16   1        alarm = MeasureGetAlarmFlag();
  17   1      
  18   1        //LED1
  19   1        if(GetOutputDAC() > 0)
  20   1        {
  21   2          GPIO_OutHigh(enumLED1);
  22   2        }
  23   1        else
  24   1        {
  25   2          GPIO_OutLow(enumLED1);
  26   2        }
  27   1      
  28   1        //LED2
  29   1        if(alarm & SET_BIT1)
  30   1        {
  31   2          GPIO_OutHigh(enumLED2);
  32   2        }
  33   1        else
  34   1        {
  35   2          GPIO_OutLow(enumLED2);
  36   2        }
  37   1        alarm = alarm & CLEAR_BIT1;
  38   1      
  39   1        //LED3
  40   1        if(alarm & SET_BIT2)
  41   1        {
  42   2          GPIO_OutHigh(enumLED3);
  43   2        }
  44   1        else
  45   1        {
  46   2          GPIO_OutLow(enumLED3);
  47   2        }
  48   1        alarm = alarm & CLEAR_BIT2;
  49   1      
  50   1        //LED4
  51   1        if(alarm)  //如果还有告警
  52   1        {
  53   2          GPIO_OutHigh(enumLED4);
  54   2        }
