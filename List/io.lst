   9          //IO口初始化
  10          void GPIO_Init(void)
  11          {
  12   1        //准双向口:00
  13   1        P3M1 &= CLEAR_BIT5;   P3M0 &= CLEAR_BIT5;   //P3.5 uart cs
  14   1        
  15   1        P2M1 &= CLEAR_BIT4;   P2M0 &= CLEAR_BIT4;   //P2.4 spi sclk
  16   1        P2M1 &= CLEAR_BIT5;   P2M0 &= CLEAR_BIT5;   //P2.5 spi cs 
  17   1        P2M1 &= CLEAR_BIT3;   P2M0 &= CLEAR_BIT3;   //P2.3 spi data
  18   1        
  19   1        P0M1 &= CLEAR_BIT7;   P0M0 &= CLEAR_BIT7;   //P0.7 PTT
  20   1      
  21   1        //高阻输入:10
  22   1        P0M1 |= SET_BIT6;   P0M0 &= CLEAR_BIT6;   //P0.6 alarm
  23   1        
  24   1        //推挽输出
  25   1        P4M1 &= CLEAR_BIT4;   P4M0 &= SET_BIT4;   //P4.4 射频源控制ONoff
  26   1        P3M1 &= CLEAR_BIT4;   P3M0 &= SET_BIT4;   //P3.4 led
  27   1      }
