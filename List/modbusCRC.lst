 100   1        crcIn = dataIn[length - 1] << 8;
 101   1        crcIn = crcIn | dataIn[length - 2];
 102   1      
 103   1        if (crcCal == crcIn)
 104   1          return 1;
 105   1        else
 106   1          return 0;
